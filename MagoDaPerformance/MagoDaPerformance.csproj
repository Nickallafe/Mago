<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MagoDaPerformance</AssemblyName>
    <RootNamespace>MagoDaPerformance</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\icon.ico</ApplicationIcon>
    <StartupObject>MagoDaPerformance.Program</StartupObject>
    <Version>0.2.0</Version>
    <FileVersion>0.2.0.0</FileVersion>
    <Product>Mago da Performance</Product>
    <Company>Ribanense Solucoes</Company>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

</Project>
